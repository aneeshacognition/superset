{
    "compilerOptions": {
      "rootDir": "src",
      "outDir": "dist",
      "target": "es2019",
      "module": "commonjs",
      "ignoreDeprecations": "6.0",
      "isolatedModules": true,
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*"]
  }
