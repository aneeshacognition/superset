{
  "extends": "../../tsconfig.json",
  "compilerOptions": {

    // Directory Overrides: Parent config paths are relative to frontend root,
    // but packages need paths relative to their own directory
    "outDir": "lib",
    "rootDir": "src",
    "declarationDir": "lib"
  },
  "include": ["src/**/*", "types/**/*"],
  "exclude": ["src/**/*.test.*", "src/**/*.stories.*"]
}
